# ===========================================
# AgriSeva-AI — AI Agent Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file to version control
# ===========================================

# --- LLM: Anthropic (Claude) ---
# Primary LLM for translation and follow-up quality
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FAST=claude-haiku-4-5-20251001

# --- LLM: MiniMax (self-hosted, OpenAI-compatible) ---
# Used by planner, synthesizer, crop-classification, and retrieval sanitizer
# All three must be provided for the agent to function
MINIMAX_BASE_URL=http://your-minimax-server:8001/v1/
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.7

# --- LLM: OpenAI-compatible endpoint ---
# Used by the main openai client (e.g. self-hosted or commercial)
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://your-openai-compatible-server/v1

# --- LLM: Gemma (self-hosted, OpenAI-compatible) ---
# Used by weather, market and daily-price agents
GEMMA_MODEL=google/gemma-4-26B-A4B-it
GEMMA_BASE_URL=http://your-gemma-server:8013/v1
WEATHER_GEMMA_BASE_URL=http://your-gemma-server:8014/v1

# --- Infrastructure: Internal services ---
# REMOTE_IP is the Tailscale / internal IP of your MCP server node
REMOTE_IP=your.tailscale.or.internal.ip

# Golden API (GDB search)
GOLDEN_API_URL=http://your-golden-api-host:8110
GOLDEN_API_TIMEOUT_S=120
GOLDEN_RAG_TOP_K=5
GOLDEN_GEMMA_TIMEOUT_S=30
GOLDEN_TIE_BREAK_MIN=2

# --- MCP service URLs ---
# Override individual MCP endpoints if they differ from REMOTE_IP defaults
DAILY_PRICE_MCP_URL=http://your-mcp-host:8111/mcp

# --- LLM: Query Refinement (Gemma-compatible) ---
QUERY_REFINEMENT_BASE_URL=http://your-gemma-server:8013/v1

# --- RAG: Golden Dataset (MongoDB Atlas Vector Search) ---
GOLDEN_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
GOLDEN_EMBEDDING_ENDPOINT=http://your-embedding-server:6001/embed
GOLDEN_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
GOLDEN_MONGODB_INDEX=review_questions_vector_index
GOLDEN_MONGODB_DATABASE=agriai
GOLDEN_MONGODB_COLLECTION=questions
GOLDEN_MONGODB_SEARCH_INDEX=review_questions_search_index
GOLDEN_CROP_MASTER_COLLECTION=crop_master
# Literal Python dict module (Mongo sync → crop_chemical_name.py → memory). Rebuild:
# python -m agriseva.agents.build_crop_master_dictionary
GOLDEN_CROP_CHEMICAL_NAME_PATH=agriseva/agents/crop_chemical_name.py

# --- Weather: OpenWeather API ---
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Weather: IMD (self-hosted wrapper) ---
IMD_WEATHER_API_URL=http://your-imd-wrapper:6103/imd/weather
IMD_CITY_BASE=http://your-imd-service:18080/city/api
IMD_MAUSAM_BASE=http://your-imd-service:18080/mausam/api

# --- Market prices: Agricultural APIs ---
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1
ENAM_BASE_URL=https://enam.gov.in/web/Ajax_ctrl

# --- Database: WhatsApp thread logs (separate MongoDB) ---
WHATSAPP_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whatsapp

# --- Database: LangGraph checkpoint store (PostgreSQL) ---
DATABASE_URI=postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# --- Thread logging ---
# Per-thread log files: logs/{thread_id}.txt (disable with THREAD_FILE_LOGGING=false)
THREAD_LOG_DIR=logs
THREAD_FILE_LOGGING=true
# MongoDB thread logs (agriai.langgraph_log): one document per thread_id (_id)
THREAD_LOG_MONGODB=true
THREAD_LOG_MONGODB_COLLECTION=langgraph_log
# Async by default (non-blocking). Set THREAD_LOG_MONGO_SYNC=true only for debugging.
# THREAD_LOG_MONGO_SYNC=false
# THREAD_LOG_MONGO_WORKERS=4

# --- Redis (optional: distributed broker for SSE streaming) ---
# REDIS_URL=redis://redis:6379/0?socket_timeout=10
# REDIS_BROKER_ENABLED=false  # single-container dev: in-memory broker + local executor

# --- Question source channel ---
# Reviewer upload channel when LangGraph configurable.question_source is not set
# NOTE: "AGRISEVA_AI" is a data-channel identifier in the DB — do NOT change unless
# you also migrate all existing records in the database.
QUESTION_SOURCE=AGRISEVA_AI

# --- LGD: Official Local Government Directory ---
# Generate an API key at https://data.gov.in/
LGD_API_KEY=
LGD_STATES_API_URL=https://api.data.gov.in/resource/a71e60f0-a21d-43de-a6c5-fa5d21600cdb
LGD_DISTRICTS_API_URL=https://api.data.gov.in/resource/37231365-78ba-44d5-ac22-3deec40b9197
LGD_CACHE_TTL_SECONDS=86400
LGD_REQUEST_TIMEOUT_SECONDS=10

# --- Feature flags ---
# Enable/disable the planner graph (set false to use legacy flow)
USE_PLANNER_GRAPH=true
