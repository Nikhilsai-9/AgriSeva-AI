# ===========================================
# AgriSeva-AI — Root Environment Variables
# ===========================================
# This file covers the full-stack Docker deployment.
# Copy to .env and fill all values before running.
#
# Run the app stack (build locally):
#   docker compose -f docker-compose.app.yml up --build
#
# Portainer / pull-only (VITE_* passed as stack env → runtime-config.js in container):
#   docker compose -f docker-compose.pull.yml pull
#   docker compose -f docker-compose.pull.yml up -d
#
# SSH build frontend locally (not Portainer):
#   docker compose --env-file .env.deployed -f docker-compose.pull-build.yml up -d --build
#
# GCP service account: keep the JSON file on the host (not in the image).
# Set GCP_CREDENTIALS_HOST_PATH to its location; compose mounts it read-only.

# --- Docker Hub (docker-compose.pull.yml only) ---
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# --- Docker / GCP credentials ---
# Host path (install once: sudo cp backend/gcp-service-account.json /opt/reviewer/secrets/)
GCP_CREDENTIALS_HOST_PATH=/opt/reviewer/secrets/gcp-service-account.json
# Path inside the backend container (do not change unless you change the volume mount)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# --- Ports (docker-compose.app.yml / docker-compose.pull.yml) ---
# APP_PORT — API listens on this port inside reviewer-backend; nginx proxies here too
APP_PORT=4000
# BACKEND_HOST_PORT — port on the host machine for direct API access (optional; defaults to APP_PORT)
BACKEND_HOST_PORT=4000
# FRONTEND_PORT — port on the host for the web UI
FRONTEND_PORT=8080

# --- Backend: app ---
NODE_ENV=production
APP_MODULE=all
APP_URL=http://localhost:8080
APP_ORIGINS=http://localhost:8080
APP_ROUTE_PREFIX=/api
FRONTEND_URL=http://localhost:8080
ADMIN_PASSWORD=

# --- Backend: database (MongoDB) ---
DB_URL=mongodb+srv://<user>:<password>@<cluster>/?appName=<name>
DB_NAME=agriai
SKIP_DB_CONNECTION=

# --- Backend: analytics database ---
DB_URL_ANALYTICS=
DB_NAME_ANALYTICS=
ANNAM_URL_ANALYTICS=
ANNAM_DB_ANALYTICS=

# --- Backend: Firebase Admin (server) ---
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase emulators (local dev only)
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_EMULATOR_HOST=
GCLOUD_PROJECT=

# --- Backend: GCP backups ---
GCP_BACKUP_BUCKET=
ENABLE_DB_BACKUP=false

# --- Backend: storage (GCS buckets) ---
GOOGLE_ANOMALY_BUCKET=
GOOGLE_FACES_BUCKET=
GOOGLE_AI_SERVER_BUCKET=
MEDIA_ENCRYPTION_KEY=

# --- Backend: AI / upstream services ---
ENABLE_AI_SERVER=false
# LangGraph/AI agent server
AI_SERVER_IP=localhost
AI_SERVER_PORT=9017
AGENT_SERVER_IP=localhost
AGENT_SERVER_PORT=9017
AI_PROXY_ADDRESS=
OPENAI_SERVER_IP=localhost
OPENAI_SERVER_PORT=8080
WHATSAPP_SERVER_PORT=
# Agent Search (Golden search + extract endpoint)
AGENT_SEARCH_URL=http://localhost:6002
# GDB Server (Golden Dataset API)
GDB_SERVER_IP=localhost
GDB_SERVER_PORT=8110
# Gemma self-hosted model
GEMMA_API=
GEMMA_API_KEY=
# LangGraph server
LANGRAPH_SERVER_IP=localhost
LANGRAPH_SERVER_PORT=9017
# Sarvam AI (speech/translation)
SARVAM_API_KEY=
# ACC Agent (Human-in-the-Loop)
ACC_AGENT_BASE_URL=
ACC_AGENT_ASSISTANT_ID=
ACC_AGENT_TIMEOUT=10000

# --- Backend: webhooks / internal API ---
INTERNAL_API_KEY=
WA_WEBHOOK_API_URL=
WA_WEBHOOK_API_KEY=
WA_SEND_MESSAGE_WEBHOOK_API_URL=
WEB_WEBHOOK_API_URL=
WEB_WEBHOOK_API_KEY=

# --- Backend: FAQ / POP proxy ---
FAQ_API_URL=
POP_API_URL=

# --- Backend: email / SMTP ---
EMAIL_USER=
EMAIL_PASS=
BACKUP_NOTIFICATION_EMAIL=
SMTP_USER=
SMTP_PASS=

# --- Backend: SMS ---
FAST2SMS_API_KEY=

# --- Backend: push notifications (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# --- Backend: voice calling (Plivo) ---
PLIVO_STREAM_URL=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# --- Backend: observability (Sentry) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Backend: data release ---
DATA_RELEASE_URL=
REVIEW_SYSTEM_AUTH_KEY=

# --- Backend: LGD (Location data) ---
LGD_API_KEY=
LGD_VILLAGES_API_URL=https://api.data.gov.in/resource/f17a1608-5f10-4610-bb50-a63c80d83974
LGD_STATES_API_URL=https://api.data.gov.in/resource/a71e60f0-a21d-43de-a6c5-fa5d21600cdb
LGD_DISTRICTS_API_URL=https://api.data.gov.in/resource/37231365-78ba-44d5-ac22-3deec40b9197
LGD_SUBDISTRICTS_API_URL=https://api.data.gov.in/resource/6be51a29-876a-403a-a6da-42fde795e751

# --- Frontend (VITE_* — baked into the image at build time) ---
VITE_ENABLE_MOCKS=false
VITE_API_BASE_URL=/api

# Firebase client config (get from Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Voice input
VITE_SARVAM_API_KEY=
# Push notifications
VITE_VAPID_PUBLIC_KEY=
