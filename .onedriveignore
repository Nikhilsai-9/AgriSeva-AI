# AgriSeva-AI / OneDrive ignore list
# Prevents OneDrive from syncing noisy, regeneratable, or sensitive paths
# inside this workspace. .gitignore covers git only; OneDrive does NOT
# respect .gitignore, so this file is required to keep node_modules,
# .git packfiles, build outputs, logs and secrets out of the cloud.
#
# Syntax: OneDrive glob (https://learn.microsoft.com/onedrive/ignore-list)
#   #       - comment
#   * ? []  - wildcards
#   ending in / - directory only
#   !pattern - negation (re-include a previously-excluded path)

# ===== Dependency directories (regenerated by pnpm/npm/yarn) =====
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# ===== Version control (git objects cause packfile-lock contention) =====
.git/

# ===== Build outputs =====
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.parcel-cache/
.cache/
.turbo/
.vercel/
.netlify/

# ===== Test / coverage reports =====
coverage/
.nyc_output/
junit.xml
*.lcov
.eslintcache

# ===== Logs =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Local env / secrets (NEVER sync) =====
.env
.env.local
.env.*.local
secrets/

